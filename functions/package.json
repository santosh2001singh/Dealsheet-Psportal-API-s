{
  "name": "deal-sheet-bigquery-sync",
  "description": "Firebase Functions to sync Deal Sheet data from Nexus API to BigQuery",
  "version": "1.0.0",
  "main": "src/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "test": "node --test src/**/*.test.js",
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "deploy:rate-change-log-sync": "firebase deploy --only functions:deal-sheet-sync:rateChangeLogSync",
    "deploy:rate-change-log-trigger": "firebase deploy --only functions:deal-sheet-sync:rateChangeLogSyncTrigger",
    "deploy:rate-change-logs": "firebase deploy --only functions:deal-sheet-sync:rateChangeLogSync,functions:deal-sheet-sync:rateChangeLogSyncTrigger",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.5.0",
    "axios": "^1.6.8",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.8.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0"
  },
  "private": true
}

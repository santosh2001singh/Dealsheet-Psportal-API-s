# Copy to functions/.env and fill in values. Do not commit .env.
#   cp functions/.env.example functions/.env
#
# Firebase project for this repo is runrate-505913 (.firebaserc).
# BigQuery tables stay in cynetdatabase — do not set GCP_PROJECT to the RunRate id.
#
# Before first deploy: copy UAT Firestore nextValue for
#   workspaces/run-rate-tool/contractIdSequences/{cynet_health_deal_sheet,cynet_health_canada_deal_sheet,cynet_locums_deal_sheet}
# or health CONTRACT_IDs restart at CHC23000.
#
# Deploy only after this file is copied to .env and filled. Named deploy only — no --force.
# If CLI asks to delete existing functions (the 94 rr* ones), answer No.
#   firebase use
#   firebase deploy --only functions:dealSheetSync

# --- BigQuery (cynetdatabase) ---
GCP_PROJECT=cynetdatabase
BQ_DATASET=rr_project_data
BQ_TABLE=cynet_health_deal_sheet

BQ_SERVICE_ACCOUNT_PROJECT_ID=cynetdatabase
BQ_SERVICE_ACCOUNT_CLIENT_EMAIL=
BQ_SERVICE_ACCOUNT_PRIVATE_KEY_ID=
BQ_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Nexus ---
NEXUS_USERNAME=
NEXUS_PASSWORD=
NEXUS_BASE_URL=https://nexusapi.cynetcorp.com
NEXUS_CSRF_TOKEN=

# --- PeopleStrong (optional) ---
PS_AUTH_BASIC_TOKEN=
PS_API_KEY=

# --- Optional tunables ---
DEAL_SHEET_UPDATE_TRIGGER_MAX_PAIRS=500
DEAL_SHEET_INSERT_TRIGGER_MAX_PAGES=0
BATCH_SIZE=300
PER_PAGE=300
ENRICH_BATCH_SIZE=300
FETCH_ALL_MAX=20
MAX_RETRIES=3
BATCH_DELAY_MS=100
NEXUS_REQUEST_TIMEOUT_MS=45000
